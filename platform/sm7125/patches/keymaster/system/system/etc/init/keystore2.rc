# Start the keystore2 service.
# Keystore 2.0 changes its working directory to the first positional
# command line option, i.e., /data/misc/keystore, where it stores its
# database.
# Keystore shall run as user keystore and groups keystore, readproc, and log.
#
# See system/core/init/README.md for information on the init.rc language.
service keystore2 /system/bin/keystore2 /data/misc/keystore
    class early_hal
    user keystore
    group keystore readproc log 5666 5678
    task_profiles ProcessCapacityHigh
    # The default memlock limit of 65536 bytes is too low for keystore.
    rlimit memlock unlimited unlimited
    # Reboot to bootloader if Keystore crashes more than 4 times before `sys.boot_completed`.
    critical window=0
    interface aidl android.system.keystore2.IKeystoreService/default

# Compatibility shim: vendor init.target.rc calls exec_start wait_for_keymaster
# at late-fs. keystore2 is class early_hal so it is already running by then;
# this is a no-op oneshot to satisfy init.
service wait_for_keymaster /system/bin/true
    oneshot
    disabled
    user root
    group root

# SAMSUNG_KEYSTORE : DB_BACKUP {
on property:sys.keystore.backup_test=true
    setprop persist.keystore.syskey_change_check_cycle 5
    setprop persist.keystore.backup_cycle 6

on property:sys.keystore.backup_test=false
    setprop persist.keystore.syskey_change_check_cycle 600
    setprop persist.keystore.backup_cycle 144
# SAMSUNG_KEYSTORE : DB_BACKUP }

on post-fs-data
    mkdir /data/system/users/keystore 0750 system keystore
    restorecon /data/system/users/keystore

    write /data/system/users/keystore/info c
    chown system keystore /data/system/users/keystore/info
    chmod 0660 /data/system/users/keystore/info
    restorecon /data/system/users/keystore/info
